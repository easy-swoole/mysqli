{
    "name": "easyswoole/mysqli",
    "type": "library",
    "description": "An efficient swoole framework",
    "keywords" : ["swoole", "framework", "async","easyswoole"],
    "homepage" : "https://www.easyswoole.com/",
    "license" : "Apache-2.0",
    "authors": [
        {
            "name": "YF",
            "email": "291323003@qq.com"
        }
    ],
    "require-dev": {
        "easyswoole/swoole-ide-helper": "^1.3",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "EasySwoole\\Mysqli\\": "src/",
            "EasySwoole\\Mysqli\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php tests/run.php",
        "test:unit": "@php tests/run.php --testsuite unit",
        "test:integration": "@php tests/run.php --testsuite integration"
    },
    "require": {
        "easyswoole/spl": "^2.1",
        "php": ">=8.1",
        "ext-mysqli": "*",
        "ext-swoole": ">=5.1"
    }
}
