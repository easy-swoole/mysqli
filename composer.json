{
    "name": "easyswoole/mysqli",
    "type": "library",
    "description": "php stander lib",
    "keywords": [
        "swoole",
        "framework",
        "async",
        "easyswoole"
    ],
    "homepage": "https://www.easyswoole.com/",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "YF",
            "email": "291323003@qq.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-openssl": "*",
        "ext-sockets": "*",
        "ext-swoole": ">=5.1",
        "ext-zlib": "*",
        "easyswoole/spl": "^2.1"
    },
    "require-dev": {
        "easyswoole/swoole-ide-helper": "^1.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "EasySwoole\\Mysqli\\": "src/",
            "EasySwoole\\Mysqli\\Tests\\": "tests/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EasySwoole\\Mysqli\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "@php tests/run.php",
        "test:unit": "@php tests/run.php --testsuite unit",
        "test:integration": "@php tests/run.php --testsuite integration"
    }
}
