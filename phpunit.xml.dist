<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         failOnWarning="true"
         failOnRisky="true"
         failOnPhpunitDeprecation="true">
    <testsuites>
        <testsuite name="unit">
            <file>tests/ConfigTest.php</file>
            <file>tests/TlsTest.php</file>
            <file>tests/TlsVersionTest.php</file>
            <file>tests/DeadlineTest.php</file>
            <file>tests/SessionStateTest.php</file>
            <file>tests/FastDbApiCompatibilityTest.php</file>
            <file>tests/ConnectionTimeoutTest.php</file>
            <file>tests/ProtocolTest.php</file>
            <file>tests/CodecTest.php</file>
            <file>tests/ProtocolPayloadTest.php</file>
            <file>tests/QueryBuilderTest.php</file>
            <file>tests/QueryBuilderEnumTest.php</file>
            <file>tests/QueryBuilderIdentifierRegressionTest.php</file>
            <file>tests/QueryBuilderSafetyTest.php</file>
            <file>tests/QueryBuilderAggregateTest.php</file>
            <file>tests/ResultStreamTest.php</file>
            <file>tests/ClientChunkTest.php</file>
            <file>tests/PaginationTest.php</file>
            <file>tests/StreamingTest.php</file>
            <file>tests/QueryBuilderUpsertTest.php</file>
            <file>tests/QueryBuilderExpressionTest.php</file>
            <file>tests/QueryBuilderConditionsTest.php</file>
            <file>tests/QueryBuilderPublicApiTest.php</file>
            <file>tests/ApiContractTest.php</file>
            <file>tests/NativeTypeCompletenessTest.php</file>
            <file>tests/SelectPlannerTest.php</file>
            <file>tests/QueryBuilderStateTest.php</file>
            <file>tests/AuthenticatorTest.php</file>
            <file>tests/ClientExecutionContextTest.php</file>
            <file>tests/QueryBuilderRegressionTest.php</file>
        </testsuite>
        <testsuite name="integration">
            <file>tests/QueryBuilderAdvancedIntegrationTest.php</file>
            <file>tests/QueryBuilderFixesIntegrationTest.php</file>
            <file>tests/StreamMemoryIntegrationTest.php</file>
            <file>tests/QueryBuilderIntegrationTest.php</file>
            <file>tests/TlsIntegrationTest.php</file>
            <file>tests/ClientTest.php</file>
            <file>tests/DataTypeTest.php</file>
            <file>tests/TemporalTest.php</file>
            <file>tests/StoredProcedureRestrictionTest.php</file>
            <file>tests/LargeNumericTest.php</file>
            <file>tests/MetadataTest.php</file>
            <file>tests/DisconnectTest.php</file>
            <file>tests/FastDbUsageTest.php</file>
            <file>tests/LargePacketTest.php</file>
            <file>tests/LargeParameterMemoryTest.php</file>
            <file>tests/TransactionTest.php</file>
            <file>tests/CompressionTest.php</file>
            <file>tests/ConcurrencyTest.php</file>
        </testsuite>
    </testsuites>
</phpunit>
